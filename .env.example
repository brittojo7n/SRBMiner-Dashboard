# =============================================================================
# SRBMiner Dashboard — Environment Configuration
# =============================================================================

# --- Required: Security ------------------------------------------------------
# Cryptographic secret for session cookies (generate with: node main.js --gen-secret)
SESSION_SECRET=

# --- Required: Miner ---------------------------------------------------------
# Working directory of SRBMiner (relative to dashboard or absolute)
MINER_CWD=..\miner

# Miner launch arguments (--api-enable and --api-port are verified/added automatically)
# Example VerusHash (CPU mining):
MINER_ARGS=--algorithm verushash --pool stratum+tcp://na.luckpool.net:3956 --wallet <WALLET_ADDRESS>.<WORKER_NAME> --disable-gpu

# Miner executable name or path (default: SRBMiner-MULTI.exe on Windows, SRBMiner-MULTI on Linux)
MINER_EXE=SRBMiner-MULTI.exe

# --- Network & Access --------------------------------------------------------
# Bind address: 127.0.0.1 (local only) or 0.0.0.0 (LAN / network access)
HOST=127.0.0.1

# HTTP port (default: 4067, range: 0-65535)
PORT=4067

# Web UI password (mandatory when HOST is non-local like 0.0.0.0)
PASSPHRASE=

# --- Optional & Advanced -----------------------------------------------------
# Mirror miner stdout/stderr directly to the terminal (true/false, default: false)
FORWARD_CONSOLE=false

# Custom path to an alternate env file
# ENV_FILE=
